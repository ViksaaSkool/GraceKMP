<?xml version="1.0" encoding="utf-8"?>
<!--
  Fully transparent placeholder used as `windowSplashScreenAnimatedIcon` on
  Android 12+. The platform mandates a splash icon, but the shared Compose
  splash owns the whole scene, so an invisible icon keeps the system frame a
  plain `colorPrimary` field — identical to the iOS launch storyboard.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <size
        android:width="1dp"
        android:height="1dp" />
</shape>
