TEAM_ID=

PRODUCT_NAME=Grace
PRODUCT_BUNDLE_IDENTIFIER=com.grace.app$(TEAM_ID)

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0.4

// ---------------------------------------------------------------------------
// Monetization — see docs/monetization-setup.md for how to populate these.
// They are NOT yet read by the build; Info.plist still carries Google's sample
// AdMob IDs as safe defaults. Replace the Info.plist values with the production
// ones (or wire these through a build phase) before release.
//
//   ADMOB_APP_ID_IOS            = ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY
//   ADMOB_INTERSTITIAL_UNIT_IOS = ca-app-pub-XXXXXXXXXXXXXXXX/ZZZZZZZZZZ
//   REVENUECAT_API_KEY_IOS      = appl_XXXXXXXXXXXXXXXX
// ---------------------------------------------------------------------------

